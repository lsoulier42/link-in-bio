[TEMPLATE]
# Copy this file to .env.local (or .env in dev) and adjust the values.
# Real environment variables always win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> nelmio/cors-bundle ###
# Regular expression of allowed origins (origin_regex is enabled).
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL=mysql://link_in_bio:link_in_bio@db:3306/link_in_bio?serverVersion=8.4&charset=utf8mb4
###< doctrine/doctrine-bundle ###
